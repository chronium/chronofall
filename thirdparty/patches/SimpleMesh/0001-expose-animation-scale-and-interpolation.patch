diff --git a/SimpleMesh/ScaleChannel.cs b/SimpleMesh/ScaleChannel.cs
new file mode 100644
index 0000000..4eaf982
--- /dev/null
+++ b/SimpleMesh/ScaleChannel.cs
@@ -0,0 +1,22 @@
+// Added by ChronoFall: expose scale animation without defining experiment sampling.
+
+using System.Linq;
+using System.Numerics;
+
+namespace SimpleMesh;
+
+public record struct ScaleKeyframe(float Time, Vector3 Scale);
+
+public class ScaleChannel
+{
+    public ScaleKeyframe[] Keyframes = [];
+    public string Target = "";
+    public AnimationInterpolation Interpolation = AnimationInterpolation.Linear;
+
+    public ScaleChannel Clone() => new()
+    {
+        Target = Target,
+        Keyframes = Keyframes.ToArray(),
+        Interpolation = Interpolation,
+    };
+}

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="StbImageWriteSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ChronoFall.CharacterPresentation/ChronoFall.CharacterPresentation.csproj" />
    <ProjectReference Include="../../thirdparty/repos/SDL3-CS/SDL3-CS/SDL3-CS.csproj"
                      AdditionalProperties="CI_DONT_TARGET_ANDROID=1"
                      SetTargetFramework="TargetFramework=net8.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ChronoFall.CharacterPresentation.SdlGpu.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ChronoFallShaderSource Include="Shaders/**/*.vert.hlsl"><ShaderStage>vertex</ShaderStage></ChronoFallShaderSource>
    <ChronoFallShaderSource Include="Shaders/**/*.frag.hlsl"><ShaderStage>fragment</ShaderStage></ChronoFallShaderSource>
  </ItemGroup>
  <Target Name="CompileChronoFallCharacterPresentationShaders" AfterTargets="Build"
          Inputs="@(ChronoFallShaderSource)"
          Outputs="@(ChronoFallShaderSource->'$(OutputPath)shaders/%(RecursiveDir)%(Filename).spv');@(ChronoFallShaderSource->'$(OutputPath)shaders/%(RecursiveDir)%(Filename).msl');@(ChronoFallShaderSource->'$(OutputPath)shaders/%(RecursiveDir)%(Filename)%(Extension)')">
    <MakeDir Directories="@(ChronoFallShaderSource->'$(OutputPath)shaders/%(RecursiveDir)')" />
    <Exec Command="shadercross &quot;%(ChronoFallShaderSource.FullPath)&quot; --source HLSL --dest SPIRV --stage %(ChronoFallShaderSource.ShaderStage) --entrypoint main --output &quot;$(OutputPath)shaders/%(RecursiveDir)%(Filename).spv&quot;" />
    <Exec Command="shadercross &quot;%(ChronoFallShaderSource.FullPath)&quot; --source HLSL --dest MSL --stage %(ChronoFallShaderSource.ShaderStage) --entrypoint main --output &quot;$(OutputPath)shaders/%(RecursiveDir)%(Filename).msl&quot;" />
    <Copy SourceFiles="@(ChronoFallShaderSource)"
          DestinationFiles="@(ChronoFallShaderSource->'$(OutputPath)shaders/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>

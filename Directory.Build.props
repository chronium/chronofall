<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <Company>ChronoFall</Company>
    <Product>ChronoFall</Product>
    <Authors>ChronoFall</Authors>
    <ChronoFallFamilyRoot Condition="'$(ChronoFallFamilyRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)'))</ChronoFallFamilyRoot>
  </PropertyGroup>
</Project>

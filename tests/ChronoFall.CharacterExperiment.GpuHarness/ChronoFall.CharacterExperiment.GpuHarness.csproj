<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ChronoFallEffectiveRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</ChronoFallEffectiveRuntimeIdentifier>
    <ChronoFallEffectiveRuntimeIdentifier Condition="'$(ChronoFallEffectiveRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</ChronoFallEffectiveRuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/ChronoFall.CharacterExperiment.SdlGpu/ChronoFall.CharacterExperiment.SdlGpu.csproj" />
    <ProjectReference Include="../../src/ChronoFall.CharacterExperiment.SimpleMesh/ChronoFall.CharacterExperiment.SimpleMesh.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(ChronoFallEffectiveRuntimeIdentifier)' == 'osx-arm64'">
    <None Include="../../thirdparty/repos/SDL3-CS/native/osx-arm64/libSDL3.dylib"
          CopyToOutputDirectory="PreserveNewest"
          TargetPath="runtimes/osx-arm64/native/libSDL3.dylib" />
  </ItemGroup>
  <Target Name="CopyChronoFallCharacterExperimentShaders" AfterTargets="Build">
    <ItemGroup>
      <CharacterExperimentShaderAsset Include="../../src/ChronoFall.CharacterExperiment.SdlGpu/bin/$(Configuration)/$(TargetFramework)/shaders/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(CharacterExperimentShaderAsset)"
          DestinationFiles="@(CharacterExperimentShaderAsset->'$(OutputPath)shaders/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
